# ---- Server ----
NODE_ENV=development
PORT=4000
# Public origin of this API (used to build absolute URLs in logs / webhooks)
PUBLIC_URL=http://localhost:4000
# Comma-separated list of browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=info

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Used only by `npm test` (created automatically if it does not exist)
TEST_DATABASE_URL=postgresql://user:password@host/dbname_test?sslmode=require
# Set to "false" to disable TLS (local docker postgres)
DB_SSL=true
DB_POOL_MAX=10

# ---- Auth ----
# Long random string; the admin app must use the SAME value as ADMIN_SESSION_SECRET
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h
JWT_REMEMBER_EXPIRES_IN=30d

# ---- Initial admin (used by `npm run db:seed`) ----
ADMIN_NAME=Karan Sharma
ADMIN_EMAIL=admin@bimcareeracademy.com
ADMIN_PASSWORD=change-me

# Seed demo enquiries / notes so the admin dashboard is not empty (dev only)
SEED_DEMO_DATA=true

# ---- Uploads ----
# disk = files under UPLOAD_DIR (local dev, VPS). db = stored in PostgreSQL — use on hosts
# whose filesystem is wiped on redeploy (Render free tier). `npm run uploads:import` copies
# existing disk files into the database.
UPLOAD_STORAGE=disk
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ---- Rate limiting (set RATE_LIMIT_ENABLED=false to disable, e.g. in tests) ----
RATE_LIMIT_ENABLED=true

# ---- Admin console origin (password-reset links point here) ----
ADMIN_URL=http://localhost:3001

# ---- Email (password reset). Leave SMTP_HOST empty in development to log emails instead ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BIM Career Academy <no-reply@bimcareeracademy.com>"
PASSWORD_RESET_TTL_MINUTES=60
