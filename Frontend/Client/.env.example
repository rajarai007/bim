# Public origin of the BIM backend API (also used to load catalogue images)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional: different origin for server-side requests (e.g. inside docker)
# API_INTERNAL_URL=http://backend:4000
# Set to "true" only when the API is reachable via a private-network IP (see next.config.ts)
# IMAGES_ALLOW_LOCAL_IP=true
# Shared with the API's REVALIDATE_SECRET: lets admin edits expire the page cache
# immediately (app/api/revalidate). Without it pages still refresh every minute.
# REVALIDATE_SECRET=
# Canonical origin used for canonical URLs, the sitemap, Open Graph tags and structured data.
# Defaults to https://bimcareeracademy.com; only set it if the site moves to another domain.
# NEXT_PUBLIC_SITE_URL=https://bimcareeracademy.com
# Ownership tags for Google Search Console / Bing Webmaster Tools (the "HTML tag" method).
# Paste only the content value; a new deploy adds the tag to every page.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
