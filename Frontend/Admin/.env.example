# Origin of the BIM backend API (also used to load catalogue images)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional: different origin for server-side requests (e.g. inside docker)
# API_INTERNAL_URL=http://backend:4000

# Must match the backend's JWT_SECRET — used to verify the session cookie locally
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Public website origin (links on the Content screen)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "true" only when the API is reachable via a private-network IP (see next.config.ts)
# IMAGES_ALLOW_LOCAL_IP=true
